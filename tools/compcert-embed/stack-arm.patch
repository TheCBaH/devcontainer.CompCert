+let transl_code f il it1p =
+  let rec forward acc it1p = function
+  | [] -> acc
+  | i1 :: il' -> forward ((i1, it1p) :: acc) (it1_is_parent it1p i1) il'
+  in
+  let rec back c = function
+  | [] -> OK c
