+        go { onormal = o.onormal;
+             obreak = acc.obreak || o.obreak;
+             ocontinue = acc.ocontinue || o.ocontinue;
+             oreturn = acc.oreturn || o.oreturn;
+             ogoto = StringSet.union acc.ogoto o.ogoto } rest in
+    go { onormal = i.inormal; obreak = false; ocontinue = false;
