+        | _ -> (Array.of_list (List.rev nodes), Array.of_list (List.rev (t :: heads))) in
+      let nodes, items = spine [] [] s in
+      let items = Array.map bal items in
+      let n = Array.length items in
+      if in_switch || n <= balance_threshold then begin
+        let acc = ref items.(n - 1) in
+        for i = n - 2 downto 0 do
+          acc := {nodes.(i) with sdesc = Sseq(items.(i), !acc)}
+        done;
+        !acc
+      end else begin
+        let rec build lo hi =
+          if hi - lo = 1 then items.(lo)
+          else
+            let mid = (lo + hi) / 2 in
+            {nodes.(lo) with sdesc = Sseq(build lo mid, build mid hi)} in
+        build 0 n
+      end
+  | Sif(e, s1, s2) -> {s with sdesc = Sif(e, bal s1, bal s2)}
+  | Swhile(e, s1) -> {s with sdesc = Swhile(e, bal s1)}
+  | Sdowhile(s1, e) -> {s with sdesc = Sdowhile(bal s1, e)}
+  | Sfor(s1, e, s2, s3) -> {s with sdesc = Sfor(bal s1, e, bal s2, bal s3)}
+  | Sswitch(e, s1) -> {s with sdesc = Sswitch(e, balance_stmt true s1)}
+  | Slabeled(lbl, s1) -> {s with sdesc = Slabeled(lbl, bal s1)}
+  | Sblock sl -> {s with sdesc = Sblock(List.map bal sl)}
+  | _ -> s
+
