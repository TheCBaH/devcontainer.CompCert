+        v with AST.gvar_info = fp32_type v.AST.gvar_info;
+               AST.gvar_init = List.map (function
+                 | AST.Init_float64 f -> AST.Init_int64(Float.to_bits f)
+                 | i -> i) v.AST.gvar_init } in
