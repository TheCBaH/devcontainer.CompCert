+  | Ederef(x, _) -> Ederef(fp32_expr x, typ)
+  | Efield(x, id, _) -> Efield(fp32_expr x, id, typ)
+  | Evalof(x, _) -> Evalof(fp32_expr x, typ)
+  | Eaddrof(x, _) -> Eaddrof(fp32_expr x, typ)
