+    Composite(id, su, List.map (function
+      | Member_plain(id, t) -> Member_plain(id, fp32_type t)
+      | m -> m) ms, a)) p.prog_types in
+  let ce = match build_composite_env types with
+    | Errors.OK ce -> ce
+    | Errors.Error _ -> fp32_fail "invalid lowered composite layout" in
+  let defs = List.map (fun (id, d) -> id, definition d) p.prog_defs in
+  fp32_forbidden_builtins := [];
+  fp32_composites := Maps.PTree.empty;
+  { p with prog_defs = List.map helper_function_declaration fp32_helpers @ defs;
+           prog_types = types; prog_comp_env = ce;
+           prog_public = List.map (fun (n, _, _) -> intern_string n) fp32_helpers @ p.prog_public }
+
