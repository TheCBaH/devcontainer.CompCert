+let check_fp32_kernel_signature sg =
+  let integer_type = function
+    | Tint | Tlong | Tany32 -> true
+    | Tfloat | Tsingle | Tany64 -> false in
+  if sg.sig_cc.cc_vararg <> None
+     || not (List.for_all integer_type (proj_sig_args sg))
+     || not (integer_type (proj_sig_res sg)) then
+    raise (Error "FP32 kernel: only non-variadic integer/pointer interfaces are supported")
+
+let check_fp32_kernel_instruction = function
+  | Pj_r (X1, _) -> ()
+  | Pjal_s _ | Pjal_r _ | Pj_s _ | Pj_r _ ->
+      raise (Error "FP32 kernel: calls and tail calls are unsupported")
+  | Pbuiltin ((EF_annot _ | EF_debug _), _, _) -> ()
+  | Pbuiltin _ ->
+      raise (Error "FP32 kernel: unexpanded builtins and inline assembly are unsupported")
+  | Pmv (_, _)
+  | Paddiw (_, _, _)
+  | Psltiw (_, _, _)
