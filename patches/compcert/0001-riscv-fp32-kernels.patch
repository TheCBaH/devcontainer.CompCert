+let rec fp32_stmt ret = function
+  | Csyntax.Sskip -> Csyntax.Sskip
+  | Csyntax.Sdo e -> Csyntax.Sdo(fp32_expr e)
+  | Csyntax.Ssequence(a, b) -> Csyntax.Ssequence(fp32_stmt ret a, fp32_stmt ret b)
+  | Csyntax.Sifthenelse(e, a, b) -> Csyntax.Sifthenelse(fp32_bool e, fp32_stmt ret a, fp32_stmt ret b)
+  | Csyntax.Swhile(e, s) -> Csyntax.Swhile(fp32_bool e, fp32_stmt ret s)
+  | Csyntax.Sdowhile(e, s) -> Csyntax.Sdowhile(fp32_bool e, fp32_stmt ret s)
+  | Csyntax.Sfor(a, e, b, s) ->
+      Csyntax.Sfor(fp32_stmt ret a, fp32_bool e, fp32_stmt ret b, fp32_stmt ret s)
+  | Csyntax.Sbreak -> Csyntax.Sbreak
+  | Csyntax.Scontinue -> Csyntax.Scontinue
+  | Csyntax.Sreturn None -> Csyntax.Sreturn None
+  | Csyntax.Sreturn(Some e) -> Csyntax.Sreturn(Some(fp32_cast e ret))
+  | Csyntax.Sswitch(e, ls) -> Csyntax.Sswitch(fp32_expr e, fp32_labels ret ls)
+  | Csyntax.Slabel(id, s) -> Csyntax.Slabel(id, fp32_stmt ret s)
+  | Csyntax.Sgoto id -> Csyntax.Sgoto id
+
+and fp32_labels ret = function
+  | Csyntax.LSnil -> Csyntax.LSnil
+  | Csyntax.LScons(n, s, ls) -> Csyntax.LScons(n, fp32_stmt ret s, fp32_labels ret ls)
+
+let fp32_program p =
+  fp32_composites := p.prog_comp_env;
+  fp32_forbidden_builtins := List.fold_left (fun acc -> function
+    | id, AST.Gfun(External(AST.EF_builtin(_, sg), _, _, _))
+        when List.mem AST.Xfloat sg.AST.sig_args || sg.AST.sig_res = AST.Xfloat ->
+        id :: acc
+    | id, AST.Gfun(External(AST.EF_runtime(name, sg), _, _, _))
+        when name <> "__compcert_va_float64"
+          && (List.mem AST.Xfloat sg.AST.sig_args || sg.AST.sig_res = AST.Xfloat) ->
+        id :: acc
+    | _ -> acc) [] p.prog_defs;
+  let vars = List.map (fun (id, t) -> id, fp32_type t) in
+  let definition = function
+    | AST.Gfun(Internal f) -> AST.Gfun(Internal {
+        f with fn_return = fp32_type f.fn_return;
+               fn_params = vars f.fn_params;
+               fn_vars = vars f.fn_vars;
+               fn_body = fp32_stmt f.fn_return f.fn_body })
+    | AST.Gfun(External(AST.EF_runtime(name, _), _, _, _)) as d
+        when name <> "__compcert_va_float64" -> d
+    | AST.Gfun(External(ef, ts, t, cc)) ->
+        AST.Gfun(External(fp32_external ef, List.map fp32_type ts, fp32_type t, cc))
