+      else Ebinop(op, fp32_expr x, fp32_expr y, typ)
+  | Ecast(x, t) -> fp32_cast x t
+  | Eseqand(x, y, _) -> Eseqand(fp32_bool x, fp32_bool y, typ)
+  | Eseqor(x, y, _) -> Eseqor(fp32_bool x, fp32_bool y, typ)
+  | Econdition(x, y, z, t) ->
+      Econdition(fp32_bool x, fp32_cast y t, fp32_cast z t, typ)
+  | Esizeof(t, _) -> Esizeof(fp32_type t, typ)
+  | Ealignof(t, _) -> Ealignof(fp32_type t, typ)
+  | Eassign(x, y, _) -> Eassign(fp32_expr x, fp32_cast y (typeof x), typ)
+  | Eassignop(op, x, y, t, _) ->
