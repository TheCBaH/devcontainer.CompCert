+let check_fp32_kernel_signature sg =
+  let supported_type = function
+    | Tint | Tlong | Tany32 -> true
+    | Tsingle -> fp32_calls
+    | Tfloat | Tany64 -> false in
+  let bad_types =
+    not (List.for_all supported_type (proj_sig_args sg))
