+module Fp32 = struct
+  type loc = G of int | F of int | S of int
+  type piece = { pos: int; bytes: int; loc: loc; narrow: bool; shift: int; bits: int }
+  type value = { size: int; indirect: bool; pieces: piece list }
+  type state = { mutable ri: int; mutable rf: int; mutable stack: int }
+  let assembly = ref []
+  let declarations = ref []
+  let serial = ref 0
+  let va_parameter = ref None
+  let enabled () = Configuration.abi = "fp32"
+  let reset () = assembly := []; declarations := []; serial := 0; va_parameter := None
+  let word () = (!Machine.config).sizeof_ptr
+  let align n a = (n + a - 1) / a * a
+  let size env ty = match sizeof env ty with Some n -> n | None -> assert false
+  let alignment env ty = match alignof env ty with Some n -> n | None -> assert false
+  let ptr = TPtr(TVoid [], [])
+  let fresh prefix = incr serial; Env.fresh_ident (Printf.sprintf "__compcert_fp32_%s_%d" prefix !serial)
+  let aggregate env ty = is_composite_type env ty
+  let rec fields env base ty =
+    match unroll env ty with
+    | TStruct(id, _) ->
+        let ci = Env.find_struct env id in
+        let pos=ref 0 in
+        List.concat (List.map (fun f ->
+          match f.fld_bitfield with
+          | Some width ->
+              let a=8 * alignment env f.fld_typ and n=8 * size env f.fld_typ in
+              let next=(!pos/a)*a+n in
+              let start=if width=0 then align !pos a
+                        else if !pos+width<=next then !pos else next in
+              pos:=start+width;
+              if width=0 then [] else [base+start/8,(width+7)/8,false,start mod 8,width]
+          | None ->
+              let off=offsetof env ty f in
+              pos:=8*(off+size env f.fld_typ);
+              fields env (base+off) f.fld_typ) ci.Env.ci_members)
+    | TArray(t, Some n, _) when n = 0L || size env t = 0 -> []
+    | TArray(t, Some n, _) ->
+        if n > 2L then raise Exit;
+        List.concat (List.init (Int64.to_int n) (fun i -> fields env (base + i * size env t) t))
+    | TFloat(FFloat, _) -> [base, 4, true, 0, 0]
+    | TInt _ | TEnum _ -> [base, size env ty, false, 0, 0]
+    | TUnion _ when size env ty = 0 -> []
+    | TUnion _ | TFloat _ | TArray _ | TPtr _ | TVoid _ | TFun _ | TNamed _ -> raise Exit
+  let gpr st bytes narrow =
+    if st.ri < 8 then begin let i = st.ri in st.ri <- i + 1; {pos=0; bytes; loc=G i; narrow;shift=0;bits=0} end
+    else begin
+      st.stack <- align st.stack (word ());
+      let o = st.stack in st.stack <- o + word (); {pos=0; bytes; loc=S o; narrow;shift=0;bits=0}
+    end
+  let classify env st named ty =
+    let w = word () in
+    let sz = size env ty in
+    let make indirect pieces = {size=sz; indirect; pieces} in
+    if aggregate env ty then begin
+      let flat = try fields env 0 ty with Exit -> [] in
+      let nf = List.length (List.filter (fun (_,_,f,_,_) -> f) flat) in
+      let ni = List.length flat - nf in
+      if named && nf > 0 && nf <= 2 && ni <= 1 && nf + ni <= 2
+         && st.rf + nf <= 8 && st.ri + ni <= 8
+         && List.for_all (fun (_,n,f,_,_) -> f || n <= w) flat then
+        make false (List.map (fun (pos,bytes,f,shift,bits) ->
+          let loc = if f then (let i=st.rf in st.rf<-i+1; F i)
+                    else (let i=st.ri in st.ri<-i+1; G i) in
+          {pos;bytes;loc;narrow=false;shift;bits}) flat)
+      else if sz = 0 then make false []
+      else if sz > 2*w then make true [gpr st w false]
+      else begin
+        let al = min 16 (max w (alignment env ty)) in
+        if not named && al > w then st.ri <- align st.ri 2;
+        if st.ri >= 8 then st.stack <- align st.stack al;
+        let parts = List.init ((sz+w-1)/w) (fun i ->
+          let p = gpr st (min w (sz-i*w)) false in {p with pos=i*w}) in
+        make false parts
+      end
+    end else match unroll env ty with
+    | TFloat(FFloat, _) when named && st.rf < 8 ->
+        let i=st.rf in st.rf<-i+1; make false [{pos=0;bytes=4;loc=F i;narrow=false;shift=0;bits=0}]
+    | _ ->
+        let bytes = max 4 sz in
+        if bytes > w && not named then st.ri <- align st.ri 2;
+        if st.ri >= 8 then st.stack <- align st.stack (max w bytes);
+        make false (List.init ((bytes+w-1)/w) (fun i ->
+          let p=gpr st (min w (bytes-i*w)) (bytes=4) in {p with pos=i*w}))
+  let state () = {ri=0;rf=0;stack=0}
