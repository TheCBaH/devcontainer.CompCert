+(* Binary64 transport is lowered in the unverified C frontend. The verified
+   backend sees integer bits; this translation needs a separate simulation. *)
+let fp32_double = function Tfloat(F64, _) -> true | _ -> false
+
+let rec fp32_type = function
+  | Tfloat(F64, a) -> Tlong(Unsigned, a)
+  | Tpointer(t, a) -> Tpointer(fp32_type t, a)
+  | Tarray(t, n, a) -> Tarray(fp32_type t, n, a)
+  | Tfunction(args, res, cc) ->
+      Tfunction(List.map fp32_type args, fp32_type res, cc)
+  | t -> t
+
+let fp32_signature sg =
+  let xtype = function AST.Xfloat -> AST.Xlong | x -> x in
+  { sg with AST.sig_args = List.map xtype sg.AST.sig_args;
+            AST.sig_res = xtype sg.AST.sig_res }
+
+let fp32_external = function
+  | AST.EF_external(n, sg) -> AST.EF_external(n, fp32_signature sg)
+  | AST.EF_runtime(n, sg) -> AST.EF_runtime(n, fp32_signature sg)
+  | AST.EF_builtin(n, sg) -> AST.EF_builtin(n, fp32_signature sg)
+  | ef -> ef
+
+let fp32_fail reason =
+  fatal_error "FP32: %s" reason
+
+let fp32_u64 = Tlong(Unsigned, noattr)
+let fp32_single = Tfloat(F32, noattr)
+let fp32_helpers = [
+  "__compcert_fp32_extend", fp32_u64, [fp32_single];
+  "__compcert_fp32_truncate", fp32_single, [fp32_u64];
+  "__compcert_fp32_va_composite", Tpointer(Tvoid, noattr),
+    [Tpointer(Tvoid, noattr); Ctyping.size_t; Ctyping.size_t]
+]
+
+let fp32_helper name arg result =
+  let ty = Tfunction([typeof arg], result, AST.cc_default) in
+  Ecall(Evalof(Evar(intern_string name, ty), ty), Econs(arg, Enil), result)
+
+let fp32_forbidden_builtins = ref []
+let fp32_composites = ref Maps.PTree.empty
+
+let rec fp32_expr e =
+  let typ = fp32_type (typeof e) in
+  match e with
+  | Eval(Vfloat f, _) -> Eval(Vlong(Float.to_bits f), typ)
+  | Eval(v, _) -> Eval(v, typ)
+  | Evar(id, _) ->
